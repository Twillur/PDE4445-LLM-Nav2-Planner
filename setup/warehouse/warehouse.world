<?xml version="1.0"?>
<!-- PDE4445 warehouse world - built to match map/warehouse_map.json (warehouse_v0_mock):
     20x20m floor, origin at SW corner, +y north, +x east.
     Three traversable aisles centred at x=6, 9, 12 (y=4..16) between four shelf rows.
     Charging dock SW (1,1), loading dock SE (18,2), packing station (15,10),
     storage zones NW (4,14) and NE (16,14), office door on west wall (y=6).
     Props are offset from the semantic target coordinates so every location
     in the JSON remains free, reachable floor space. -->
<sdf version="1.6">
  <world name="pde4445_warehouse">
    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.75 0.8 0.85 1</background>
      <shadows>false</shadows>
    </scene>

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
    </physics>

    <!-- ==================== perimeter walls ==================== -->
    <model name="wall_south">
      <static>true</static>
      <pose>10 0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>20.3 0.15 1.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>20.3 0.15 1.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>
    <model name="wall_north">
      <static>true</static>
      <pose>10 20 0.75 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>20.3 0.15 1.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>20.3 0.15 1.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>0 10 0.75 0 0 1.5708</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>20.3 0.15 1.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>20.3 0.15 1.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>20 10 0.75 0 0 1.5708</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>20.3 0.15 1.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>20.3 0.15 1.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <!-- office door: blue panel on the west wall at y=6 (visual landmark only) -->
    <model name="office_door_panel">
      <static>true</static>
      <pose>0.09 6 1.0 0 0 1.5708</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>1.2 0.05 2.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Blue</name></script></material>
        </visual>
      </link>
    </model>

    <!-- ==================== shelving: 4 rows -> aisles at x=6, 9, 12 ==================== -->
    <!-- rows are 0.8 wide x 12 long (y=4..16), 2m tall -->
    <model name="shelf_row_1">
      <static>true</static>
      <pose>4.6 10 1.0 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.8 12 2.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.8 12 2.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material>
        </visual>
      </link>
    </model>
    <model name="shelf_row_2">
      <static>true</static>
      <pose>7.5 10 1.0 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.8 12 2.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.8 12 2.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material>
        </visual>
      </link>
    </model>
    <model name="shelf_row_3">
      <static>true</static>
      <pose>10.5 10 1.0 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.8 12 2.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.8 12 2.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material>
        </visual>
      </link>
    </model>
    <model name="shelf_row_4">
      <static>true</static>
      <pose>13.4 10 1.0 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.8 12 2.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.8 12 2.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material>
        </visual>
      </link>
    </model>

    <!-- ==================== props (offset from semantic targets) ==================== -->
    <!-- charging dock marker: flat green pad under the home position -->
    <model name="charging_pad">
      <static>true</static>
      <pose>1 1 0.005 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.9 0.9 0.01</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Green</name></script></material>
        </visual>
      </link>
    </model>

    <!-- loading dock: pallet boxes against the east wall, north of the (18,2) target -->
    <model name="pallet_dock_1">
      <static>true</static>
      <pose>19.2 4.3 0.4 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.0 1.0 0.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.0 1.0 0.8</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
        </visual>
      </link>
    </model>
    <model name="pallet_dock_2">
      <static>true</static>
      <pose>19.2 5.6 0.3 0 0 0.35</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.9 0.9 0.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.9 0.9 0.6</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
        </visual>
      </link>
    </model>

    <!-- packing station: work table east of the (15,10) target -->
    <model name="packing_table">
      <static>true</static>
      <pose>16.6 10.8 0.45 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.6 0.9 0.9</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.6 0.9 0.9</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <!-- storage zone A (NW): crate stacks north-west of the (4,14) target -->
    <model name="crates_a1">
      <static>true</static>
      <pose>2.6 15.6 0.5 0 0 0.2</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.0 1.0 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.0 1.0 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
        </visual>
      </link>
    </model>
    <model name="crates_a2">
      <static>true</static>
      <pose>2.0 13.0 0.35 0 0 -0.3</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.7 0.7 0.7</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.7 0.7 0.7</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
        </visual>
      </link>
    </model>

    <!-- storage zone B (NE): crate stacks north-east of the (16,14) target -->
    <model name="crates_b1">
      <static>true</static>
      <pose>17.6 15.6 0.5 0 0 -0.15</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.0 1.0 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.0 1.0 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
        </visual>
      </link>
    </model>
    <model name="crates_b2">
      <static>true</static>
      <pose>18.2 13.2 0.35 0 0 0.4</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.7 0.7 0.7</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.7 0.7 0.7</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
        </visual>
      </link>
    </model>

    <gui>
      <camera name="user_camera">
        <pose>10 -6 18 0 0.9 1.5708</pose>
      </camera>
    </gui>
  </world>
</sdf>
